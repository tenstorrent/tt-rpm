diff --git a/barebones/link.ld b/barebones/link.ld
new file mode 100644
index 0000000..7cdeca1
--- /dev/null
+++ b/barebones/link.ld
@@ -0,0 +1,45 @@
+/* Bare-metal layout for the RPM core model.
+ * Everything lives in the executable region based at 0x80000000
+ * (matches the exec PMA region in tests/whisper.json). */
+OUTPUT_ARCH(riscv)
+ENTRY(_start)
+
+SECTIONS
+{
+    . = 0x80000000;
+
+    .text : {
+        *(.text.init)
+        *(.text .text.*)
+    }
+
+    .rodata : {
+        *(.rodata .rodata.*)
+        *(.srodata .srodata.*)
+    }
+
+    . = ALIGN(8);
+    .data : {
+        *(.data .data.*)
+        . = ALIGN(8);
+        __global_pointer$ = . + 0x800;
+        *(.sdata .sdata.*)
+    }
+
+    . = ALIGN(8);
+    .bss (NOLOAD) : {
+        __bss_start = .;
+        *(.sbss .sbss.*)
+        *(.bss .bss.*)
+        *(COMMON)
+        . = ALIGN(8);
+        __bss_end = .;
+    }
+
+    /* 256 KB stack */
+    . = ALIGN(16);
+    . = . + 0x40000;
+    _stack_top = .;
+
+    .tohost : { *(.tohost) }
+}
