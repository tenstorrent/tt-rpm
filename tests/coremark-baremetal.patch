diff --git a/barebones/crt0.S b/barebones/crt0.S
new file mode 100644
index 0000000..f57a2f7
--- /dev/null
+++ b/barebones/crt0.S
@@ -0,0 +1,43 @@
+# Minimal bare-metal startup for CoreMark on the RPM core model.
+# No OS, no syscalls. Set up gp/sp, clear .bss, call main(), then exit via the
+# HTIF "tohost" protocol. Console output also goes through tohost (see
+# ee_printf.c). The model routes tohost stores to stdout / sim-stop.
+
+    .section .text.init, "ax"
+    .global _start
+_start:
+    .option push
+    .option norelax
+    la      gp, __global_pointer$
+    .option pop
+
+    la      sp, _stack_top
+
+    # zero .bss
+    la      t0, __bss_start
+    la      t1, __bss_end
+1:
+    bgeu    t0, t1, 2f
+    sd      zero, 0(t0)
+    addi    t0, t0, 8
+    j       1b
+2:
+    call    main
+
+    # exit: write 1 to HTIF tohost (dev=0,cmd=0,payload odd) -> sim stop.
+    la      t0, tohost
+    li      t1, 1
+    sd      t1, 0(t0)
+3:
+    j       3b
+
+    # HTIF mailbox. Whisper looks these up by symbol name ("tohost"/"fromhost").
+    .section .tohost, "aw", @progbits
+    .align 6
+    .global tohost
+tohost:
+    .dword 0
+    .align 6
+    .global fromhost
+fromhost:
+    .dword 0
diff --git a/barebones/ee_printf.c b/barebones/ee_printf.c
index f2d362d..0232e47 100644
--- a/barebones/ee_printf.c
+++ b/barebones/ee_printf.c
@@ -659,23 +659,19 @@ ee_vsprintf(char *buf, const char *fmt, va_list args)
     return str - buf;
 }
 
+/* Output via the HTIF "tohost" syscall protocol (spike/riscv-pk convention),
+   which the RPM perf model routes to stdout: PerfApi::commitMemoryWrite() sees
+   a store to the tohost address and calls Hart::handleStoreToHost(), which for
+   dev=1/cmd=1 writes the low byte to stdout. tohost is a normal 8-byte store to
+   a tracked address (defined in crt0.S), so it avoids the zero-size store path
+   that the __whisper_console_io MMIO byte would hit. */
+extern volatile unsigned long tohost;
+
 void
 uart_send_char(char c)
 {
-#error "You must implement the method uart_send_char to use this file!\n";
-    /*	Output of a char to a UART usually follows the following model:
-            Wait until UART is ready
-            Write char to UART
-            Wait until UART is done
-
-            Or in code:
-            while (*UART_CONTROL_ADDRESS != UART_READY);
-            *UART_DATA_ADDRESS = c;
-            while (*UART_CONTROL_ADDRESS != UART_READY);
-
-            Check the UART sample code on your platform or the board
-       documentation.
-    */
+    /* (dev=1 << 56) | (cmd=1 << 48) | byte */
+    tohost = (1UL << 56) | (1UL << 48) | (unsigned long)(unsigned char)c;
 }
 
